# ==============================================================================
# .env.example - Environment configuration for Personal Fiduciary Agent
# All settings are optional; the harness runs 100% locally with synthetic seed data out-of-the-box.
# ==============================================================================

# 1. Local AI & LLM Inference (Default: Local Ollama on Apple Silicon Metal GPU)
LLM_PROVIDER=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Alternative: LM Studio
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=local-llama

# (Optional) Google Gemini API Key - only used if LLM_PROVIDER="gemini" or "auto"
# GEMINI_API_KEY=

# 2. UK Open Banking Connections (Optional - for live bank sync)
# TrueLayer UK Open Banking (https://console.truelayer.com)
# Connects Revolut, Chase, HSBC, NatWest, Lloyds, Zopa
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_USE_SANDBOX=false

# Wise Multi-Currency API Token (Wise -> Settings -> API tokens -> Read only)
WISE_API_TOKEN=

# 3. Local Server Configuration
PORT=8080
REDIRECT_URL=http://localhost:8080/callback
