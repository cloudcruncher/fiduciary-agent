#!/usr/bin/env bash
# Block commits that contain secrets (scans staged changes only).
set -e
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks not installed (brew install gitleaks) - refusing to commit unscanned." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --config "$(git rev-parse --show-toplevel)/.gitleaks.toml"
