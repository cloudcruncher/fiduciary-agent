#!/usr/bin/env bash
# Block pushes whose history contains secrets (scans all commits).
set -e
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks not installed (brew install gitleaks) - refusing to push unscanned." >&2
  exit 1
fi
gitleaks git --redact --no-banner --config "$(git rev-parse --show-toplevel)/.gitleaks.toml"
